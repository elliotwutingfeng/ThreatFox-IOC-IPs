{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "packageRules": [
        {
            "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest", "lockFileMaintenance"],
            "automerge": true
        }
    ],
    "lockFileMaintenance": {
        "enabled": true
    }
}
